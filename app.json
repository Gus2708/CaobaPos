{
  "expo": {
    "name": "CaobaPOS",
    "slug": "CaobaPOS",
    "version": "1.0.4",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#B87B5A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.caoba.pos",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#B87B5A"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.caoba.pos"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "7e1458fc-8c2e-4fab-a9ad-25b3ca4f7734"
      }
    },
    "owner": "gusdev2708"
  }
}
